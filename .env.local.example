# =============================================================================
# Firebase Admin SDK (server-side — NÃO expor no client)
# Valores da Service Account JSON do Firebase Console
# =============================================================================
FIREBASE_PROJECT_ID=wedding-raquel
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# Firebase JS SDK (client-side — prefixo NEXT_PUBLIC_)
# Firebase Console → Configurações do projeto → Seus apps → Web app
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wedding-raquel
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =============================================================================
# Admin do site
# =============================================================================
ADMIN_PASSWORD=

# =============================================================================
# Asaas (Gateway de Pagamentos)
# =============================================================================
# "prod" ou "production" usa api.asaas.com (produção); qualquer outro valor
# (vazio, "sandbox", typo) usa api-sandbox.asaas.com — sandbox é o padrão seguro.
ASAAS_ENV=sandbox
# Gerada em: https://sandbox.asaas.com/config/integracao
ASAAS_API_KEY=
# String aleatória: openssl rand -hex 32 — mesmo valor cadastrado no painel Asaas
ASAAS_WEBHOOK_TOKEN=

# =============================================================================
# Cron de reconciliação de pagamentos (app/api/cron/reconcile-payments)
# =============================================================================
# String aleatória: openssl rand -hex 32
# A Vercel envia automaticamente "Authorization: Bearer $CRON_SECRET" nas chamadas
# de cron quando essa env var está definida no projeto — não precisa configurar nada
# além de cadastrar o valor.
CRON_SECRET=
